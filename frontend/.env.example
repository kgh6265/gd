# Base URL of the Strapi backend (no trailing slash needed)
STRAPI_URL=https://gd-strapi.onrender.com
# Read-only Strapi API token (Settings -> API Tokens in the Strapi admin)
STRAPI_TOKEN=

# Your Supabase project URL
SUPABASE_URL=
# Supabase anon / public key
SUPABASE_KEY=

# Where Supabase sends users back to after login
REDIRECT_URL=http://localhost:3000

# Google service account email
CLIENT_EMAIL=
# Google service account private key (keep the \n escapes intact)
PRIVATE_KEY=
